{{- $item := bitwarden "item" "proxy:sing-box" -}}
{{- if ne $item.name "proxy:sing-box" -}}{{- fail "Unexpected sing-box Bitwarden item" -}}{{- end -}}
{{- if index $item "deletedDate" -}}{{- fail "Sing-box Bitwarden item is deleted" -}}{{- end -}}
{{- $fields := dict -}}
{{- range $item.fields -}}
  {{- if hasKey $fields .name -}}{{- fail "Duplicate sing-box Bitwarden field" -}}{{- end -}}
  {{- $_ := set $fields .name .value -}}
{{- end -}}
{{- range list "UUID-8001" "UUID-8003" "UUID-8004" "UUID-8005" "SERVER" "PUBLIC_KEY" -}}
  {{- if not (index $fields .) -}}{{- fail "Missing sing-box Bitwarden field" -}}{{- end -}}
{{- end -}}
{{- $yiyonex := bitwarden "item" "proxy:yiyonex" -}}
{{- if ne $yiyonex.name "proxy:yiyonex" -}}{{- fail "Unexpected Yiyonex Bitwarden item" -}}{{- end -}}
{{- if index $yiyonex "deletedDate" -}}{{- fail "Yiyonex Bitwarden item is deleted" -}}{{- end -}}
{{- $yiyonexPassword := "" -}}
{{- $yiyonexPasswordSeen := false -}}
{{- range (index $yiyonex "fields") -}}
  {{- if eq .name "PASSWORD" -}}
    {{- if $yiyonexPasswordSeen -}}{{- fail "Duplicate PASSWORD custom field in Bitwarden item proxy:yiyonex" -}}{{- end -}}
    {{- $yiyonexPasswordSeen = true -}}
    {{- $yiyonexPassword = .value -}}
  {{- end -}}
{{- end -}}
{{- if or (not (kindIs "string" $yiyonexPassword)) (not $yiyonexPassword) -}}{{- fail "Missing or empty PASSWORD custom field in Bitwarden item proxy:yiyonex" -}}{{- end -}}
