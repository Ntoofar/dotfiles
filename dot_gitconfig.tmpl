[alias]
    co = checkout
    br = branch
    ci = commit
    st = status
    ciam = commit -am
    di = diff
    usg = reset HEAD --
    tree = log --graph --decorate --pretty=oneline --abbrev-commit
    wt = worktree
    wta = worktree add
    wtl = worktree list
    wtr = worktree remove
    wtp = worktree prune
    # create and checkout to same name worktree
    wtc = "!f() { git worktree add -b \"$1\" \"../$1\" "$2"; }; f"
[user]
    name = {{ .name | quote }}
    email = {{ .email | quote }}
[core]
    editor = vim
[init]
    defaultBranch = main
[pull]
    rebase = false
[include]
    path = ~/.gitconfig.local
