[alias]
    co = checkout
    br = branch
    ci = commit
    st = status
    ciam = commit -am
    di = diff
    usg = reset HEAD --
    tree = log --graph --decorate --pretty=oneline --abbrev-commit
[user]
    name = {{ .name | quote }}
    email = {{ .email | quote }}
[core]
    editor = vim
[init]
    defaultBranch = main
[pull]
    rebase = false
[include]
    path = ~/.gitconfig.local
