#!/bin/sh
set -eu

# Re-run this script whenever the managed mise tool configuration changes.
# config-sha256: {{ include "dot_config/mise/config.toml" | sha256sum }}
# lock-sha256: {{ include "dot_config/mise/mise.lock" | sha256sum }}

mise_bin="$HOME/.local/bin/mise"
[ -x "$mise_bin" ] || exit 0

# This shared inventory downloads public releases. A self-hosted GitLab PAT
# exported in the shell is not valid on gitlab.com and must not be sent there.
# Scope this to the installer: do not change the parent shell or glab config.
(
    unset GITLAB_TOKEN MISE_GITLAB_TOKEN
    "$mise_bin" install
)
